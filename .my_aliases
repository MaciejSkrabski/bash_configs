alias uu="doas pacman -Syu"
alias cs=cdls
alias cls="clear"
alias wyłącz="systemctl poweroff"
alias reboot="systemctl reboot"
alias ls="ls --color=always"
alias vim="nvim"
alias config="/usr/bin/git --git-dir=$HOME/bash_configs/ --work-tree=$HOME"
alias orphans="pacman -Qtdq | doas pacman -Rnsc -"
alias gtd="cd ~/Documents/gtd; nvim ."
alias vc="cd ~/.config/nvim; nvim ."
